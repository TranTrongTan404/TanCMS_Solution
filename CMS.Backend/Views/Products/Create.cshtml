@model CMS.Data.Entities.Product

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Thêm sản phẩm";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-success text-white">
            <h4 class="mb-0">
                THÊM SẢN PHẨM MỚI
            </h4>
        </div>

        <div class="card-body">

            <form asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                <div class="row">

                    <div class="col-md-8">

                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Tên sản phẩm:
                            </label>

                            <input asp-for="Name"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Mô tả:
                            </label>

                            <textarea asp-for="Description"
                                      rows="6"
                                      class="form-control"></textarea>
                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Danh mục:
                            </label>

                            <select asp-for="CategoryProductId"
                                    asp-items="ViewBag.CategoryList"
                                    class="form-select">

                                <option value="">
                                    -- Chọn danh mục --
                                </option>

                            </select>

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Giá bán:
                            </label>

                            <input asp-for="Price"
                                   class="form-control" />

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Số lượng tồn:
                            </label>

                            <input asp-for="StockQuantity"
                                   class="form-control" />

                        </div>

                        <!-- CHỌN ẢNH -->

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Chọn ảnh sản phẩm:
                            </label>

                            <input type="file"
                                   name="ImageFile"
                                   class="form-control"
                                   accept="image/*" />

                        </div>

                        <hr />

                        <button type="submit"
                                class="btn btn-success">

                            Lưu sản phẩm

                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">

                            Quay lại

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>