@model CMS.Data.Entities.Product

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-warning">

            <h4 class="mb-0">
                CHỈNH SỬA SẢN PHẨM
            </h4>

        </div>

        <div class="card-body">

            <form asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                <input type="hidden"
                       asp-for="Id" />

                <input type="hidden"
                       asp-for="ImageUrl" />

                <div class="row">

                    <div class="col-md-8">

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Tên sản phẩm:
                            </label>

                            <input asp-for="Name"
                                   class="form-control" />

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Mô tả:
                            </label>

                            <textarea asp-for="Description"
                                      rows="6"
                                      class="form-control"></textarea>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Danh mục:
                            </label>

                            <select asp-for="CategoryProductId"
                                    asp-items="ViewBag.CategoryList"
                                    class="form-select">
                            </select>

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Giá bán:
                            </label>

                            <input asp-for="Price"
                                   class="form-control" />

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Số lượng tồn:
                            </label>

                            <input asp-for="StockQuantity"
                                   class="form-control" />

                        </div>

                        <!-- ẢNH HIỆN TẠI -->
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mb-3 text-center">

                                <img src="@Model.ImageUrl"
                                     class="img-thumbnail shadow"
                                     style="max-height:180px;" />

                            </div>
                        }

                        <!-- CHỌN ẢNH MỚI -->

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Chọn ảnh mới:
                            </label>

                            <input type="file"
                                   name="ImageFile"
                                   class="form-control"
                                   accept="image/*" />

                            <small class="text-muted">

                                Không chọn nếu muốn giữ ảnh cũ.

                            </small>

                        </div>

                        <hr />

                        <button type="submit"
                                class="btn btn-warning">

                            Cập nhật

                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">

                            Hủy

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>